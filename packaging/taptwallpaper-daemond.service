[Unit]
Description=Tapt Wallpaper Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# %h expands to the user's home directory in systemd user services.
ExecStart=%h/.local/bin/taptwallpaper-daemond
Restart=on-failure
RestartSec=5
# The daemon doesn't use xdg-desktop-portal features — it talks to
# plasmashell directly via D-Bus. Suppress the harmless "Failed to
# register with host portal" warning at startup.
Environment=QT_LOGGING_RULES=qt.qpa.portal=false

[Install]
WantedBy=graphical-session.target
